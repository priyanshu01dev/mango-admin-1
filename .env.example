# ---------------- Mango Invoice API server ----------------
# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000

# MongoDB must run as a replica set (transactions). Atlas does this by default.
# Local dev: `npm run db:dev` starts one on 127.0.0.1:27017 with data in .data/mongo
MONGODB_URI="mongodb://127.0.0.1:27017/mango_invoice?replicaSet=rs0"

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# Comma-separated web origins allowed to call the API
CORS_ORIGINS="http://localhost:3000"

# OTP SMS: "console" prints OTPs in the server log (dev only), "msg91" sends real SMS (DLT template needed)
SMS_PROVIDER=console
MSG91_AUTH_KEY=""
MSG91_OTP_TEMPLATE_ID=""

# e-Invoice / e-Way bill: "disabled" refuses, "mock" gives clearly-marked MOCK IRNs (blocked in production)
GSP_MODE=disabled

# Public URL of the web app (links in emails, WhatsApp and payment pages)
APP_URL="http://localhost:3000"

# Razorpay (dashboard → Settings → API keys / Webhooks). Webhook URL: <API>/api/webhooks/razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Email over SMTP (Amazon SES, Zoho, Gmail Workspace…)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Mango Invoice <no-reply@yourdomain.in>"

# WhatsApp Business Cloud API (Meta). Templates must be approved in Meta Business Manager.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_REMINDER_TEMPLATE="payment_reminder"
WHATSAPP_BROADCAST_TEMPLATE="announcement"

# MSG91 DLT template ids for reminder / broadcast SMS
MSG91_REMINDER_TEMPLATE_ID=""
MSG91_BROADCAST_TEMPLATE_ID=""

# Your company's GST registration (printed on subscription invoices)
PLATFORM_LEGAL_NAME="First Wave Technologies"
PLATFORM_GSTIN=""
PLATFORM_STATE_CODE="22"

# New businesses get a free trial of this plan
TRIAL_DAYS=7
TRIAL_PLAN=gold

# Used once by `npm run server:seed` to create the super-admin login (password: 12+ chars)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
